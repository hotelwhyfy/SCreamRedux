+/* index of the sizeof(size_t) byte in the header (see luaU_header) */
+#define SIZET_OFFSET	(sizeof(LUA_SIGNATURE)-1+4)
+
 static void LoadHeader(LoadState* S)
 {
  char h[LUAC_HEADERSIZE];
  char s[LUAC_HEADERSIZE];
  luaU_header(h);
  LoadBlock(S,s,LUAC_HEADERSIZE);
+ /* SCREAM: accept either size_t width; everything else must match */

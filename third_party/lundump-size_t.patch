+/* SCREAM: read a size_t of the width the chunk was compiled with, so 32-bit
+** chunks (the original game scripts) load on 64-bit hosts. Little-endian only. */
+static size_t LoadSize(LoadState* S)
+{
+ if (S->sizesize_t==4)
+ {
+  unsigned int x;
+  LoadMem(S,&x,1,4);
+  return (size_t)x;
+ }
+ else
+ {
+  unsigned long long x;
+  LoadMem(S,&x,1,8);
+  IF ((size_t)x!=x, "size_t too large");
+  return (size_t)x;
+ }
+}
